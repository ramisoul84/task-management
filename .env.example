# Application
APP_ENV=development
APP_NAME=task-management
APP_VERSION=1.0.0
MIGRATIONS_DIR=./migrations

# Logger
LOG_LEVEL=debug
LOG_OUTPUT=stdout

# Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=false
BODY_LIMIT_MB=10
GLOBAL_RATE_MAX=100
GLOBAL_RATE_WINDOW=1m
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW=1m

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=mysql-user
DB_PASSWORD=mysql-pass
DB_NAME=task_management
DB_TLS=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_LIFETIME=5m
DB_CONN_IDLE_TIME=1m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis-pass
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# Security
SECRET=secret-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ISSUER=task-management
COST=12


CACHE_TASK_LIST_TTL=5m