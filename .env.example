# Copy to .env (docker compose) or .env.dev (make run) and fill in secrets.
# Every variable has a safe default except the ones marked REQUIRED.

# ---------- Application ----------
APP_ENV=development            # development | test | production
APP_NAME=task-management
MIGRATIONS_DIR=./migrations
MIGRATE_ON_START=true          # set false to run `task-management migrate up` as a separate step

# ---------- Logging ----------
LOG_LEVEL=debug                # trace | debug | info | warn | error
LOG_FORMAT=console             # console (dev) | json (default outside development)
LOG_OUTPUT=stdout              # stdout | stderr | /path/to/file

# ---------- HTTP ----------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=15s       # per-request deadline propagated to MySQL/Redis
BODY_LIMIT_MB=1
ALLOWED_ORIGINS=http://localhost:4200   # comma-separated; "*" cannot be used with credentials
ALLOW_CREDENTIALS=true         # required for the refresh-token cookie from a browser
TRUSTED_PROXIES=               # comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For
ENABLE_DOCS=true               # Swagger UI at /docs
ENABLE_METRICS=true            # Prometheus metrics at /metrics (keep off the public internet)

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
GLOBAL_RATE_MAX=100            # requests per window per IP, all API routes
GLOBAL_RATE_WINDOW=1m
AUTH_RATE_MAX=20               # register/login/refresh per window per IP
AUTH_RATE_WINDOW=1m

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=task_management        # REQUIRED
DB_PASSWORD=change-me          # REQUIRED
DB_NAME=task_management        # REQUIRED
# DB_ROOT_PASSWORD=            # compose only; defaults to DB_PASSWORD
DB_TLS=false                   # false | true | skip-verify | preferred
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_LIFETIME=5m
DB_CONN_IDLE_TIME=1m

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change-me       # REQUIRED by docker compose
REDIS_DB=0
REDIS_MAX_RETRIES=2
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# Circuit breaker around Redis
REDIS_BREAKER_ENABLED=true
REDIS_BREAKER_FAILURES=5       # consecutive failures before opening
REDIS_BREAKER_OPEN_TIMEOUT=15s # how long to fail fast before probing again

# ---------- Auth ----------
# REQUIRED. At least 32 random bytes in production, e.g. `openssl rand -base64 48`
SECRET=change-me-to-a-long-random-value
ISSUER=task-management
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COST=12                        # bcrypt cost, 10-16
COOKIE_DOMAIN=
COOKIE_SECURE=false            # defaults to true when APP_ENV=production
COOKIE_SAME_SITE=Lax           # Strict | Lax | None (None requires COOKIE_SECURE=true)

# ---------- Cache ----------
CACHE_TASK_LIST_TTL=5m
